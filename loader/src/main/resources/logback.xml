<configuration>
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
	  <file>/home/iam/dev/projects/osm_to_osmosisdb_ng/myApp.log</file>
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <logger name="com.github.isuhorukov.osm.pgsnapshot.console" level="info" additivity="false">
    <appender-ref ref="STDERR" />
  </logger>

  <root level="trace">
    <appender-ref ref="FILE" />
  </root>
</configuration>
